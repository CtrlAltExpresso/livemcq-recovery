t=\"113\" data-end=\"128\">\r\n<p data-start=\"115\" data-end=\"128\">1 + 2 =<span> </span><strong data-start=\"123\" data-end=\"128\">3</strong></p>\r\n</li>\r\n<li data-start=\"129\" data-end=\"144\">\r\n<p data-start=\"131\" data-end=\"144\">2 + 3 =<span> </span><strong data-start=\"139\" data-end=\"144\">5</strong></p>\r\n</li>\r\n<li data-start=\"145\" data-end=\"160\">\r\n<p data-start=\"147\" data-end=\"160\">3 + 5 =<span> </span><strong data-start=\"155\" data-end=\"160\">8</strong></p>\r\n</li>\r\n<li data-start=\"161\" data-end=\"177\">\r\n<p data-start=\"163\" data-end=\"177\">5 + 8 =<span> </span><strong data-start=\"171\" data-end=\"177\">13</strong></p>\r\n</li>\r\n<li data-start=\"178\" data-end=\"195\">\r\n<p data-start=\"180\" data-end=\"195\">8 + 13 =<span> </span><strong data-start=\"189\" data-end=\"195\">21</strong></p>\r\n</li>\r\n<li data-start=\"196\" data-end=\"214\">\r\n<p data-start=\"198\" data-end=\"214\">13 + 21 =<span> </span><strong data-start=\"208\" data-end=\"214\">34</strong></p>\r\n</li>\r\n<li data-start=\"215\" data-end=\"233\">\r\n<p data-start=\"217\" data-end=\"233\">21 + 34 =<span> </span><strong data-start=\"227\" data-end=\"233\">55</strong></p>\r\n</li>\r\n<li data-start=\"234\" data-end=\"252\">\r\n<p data-start=\"236\" data-end=\"252\">34 + 55 =<span> </span><strong data-start=\"246\" data-end=\"252\">89</strong></p>\r\n</li>\r\n</ul>\r\n<p data-start=\"254\" data-end=\"282\">তাই<span> </span><strong data-start=\"258\" data-end=\"281\">পরবর্তী সংখ্যা = ৮৯</strong>।</p>\r\n<p data-start=\"284\" data-end=\"355\" data-is-last-node=\"\" data-is-only-node=\"\"><strong data-start=\"284\" data-end=\"299\">Exam Pearl:</strong><span> </span>Fibonacci ধারায় প্রতিটি পদ = পূর্ববর্তী দুই পদের যোগফল।</p>","is_read":false,"is_favorite":false}],"num_pages":1604,"pagination":{"current_page":1515,"page_size":50,"total_pages":1604,"total_results":80162,"has_next":true,"has_previous":true,"next_page":1516,"previous_page":1514}}