, "exp": ""}, {"id": "83", "question": "৮৩) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "84", "question": "৮৪) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "85", "question": "৮৫) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}], "আন্তর্জাতিক বিষয়াবলি": [{"id": "86", "question": "৮৬) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "87", "question": "৮৭) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "88", "question": "৮৮) সম্প্রতি কোন রাজনৈতিক ও সামরিক গোষ্ঠী বাব আল-মান্দেব প্রণালিতে ড্রোন এবং ক্ষেপণাস্ত্র হামলা চালিয়ে বৈশ্বিক জাহাজ চলাচলকে ঝুঁকিতে ফেলেছে? [অক্টোবর, ২০২৬]", "option1": "আল-কায়েদা", "option2": "হিজবুল্লাহ", "option3": "হুতি", "option4": "হামাস", "answer": "3", "exp": "<p><strong>ইয়েমেনের ইরান-সমর্থিত রাজনৈতিক ও সামরিক গোষ্ঠী হুতি বা আনসারুল্লাহ সম্প্রতি ২০২৬ সালের সেপ্টেম্বরে বাব আল-মান্দেব প্রণালিতে ড্রোন এবং ক্ষেপণাস্ত্র হামলা চালিয়ে বৈশ্বিক জাহাজ চলাচলকে বড় ধরনের ঝুঁকিতে ফেলেছে।</strong></p>\r\n<p>হুতিরা লোহিত সাগর এবং বাব আল-মান্দেব প্রণালি দিয়ে চলাচলকারী বাণিজ্যিক জাহাজ ও জ্বালানি ট্যাংকারগুলোকে লক্ষ্য করে ব্যাপক ড্রোন ও ব্যালিস্টিক ক্ষেপণাস্ত্র হামলা চালাচ্ছে। সম্প্রতি তারা এই রুটে সৌদি আরবসহ বিভিন্ন আন্তর্জাতিক বাণিজ্যিক জাহাজের ওপর নৌ অবরোধের ঘোষণা দেয়। <br>হুতি বিদ্রোহীরা লোহিত সাগরের উপকূলীয় অঞ্চল, গুরুত্বপূর্ণ বন্দরনগরী মোকা এবং বেশ কয়েকটি দ্বীপের ওপর পূর্ণ সামরিক নিয়ন্ত্রণ প্রতিষ্ঠা করেছে। এর ফলে এই আন্তর্জাতিক নৌপথে জাহাজ চলাচলের ওপর নজরদারি এবং আক্রমণ করার সক্ষমতা তাদের বহুগুণ বেড়ে গেছে।</p>\r\n<p>হুতি বিদ্রোহী:<br>- হুতি বিদ্রোহী হলো ইয়েমেনের একটি শিয়া ইসলামপন্থী রাজনৈতিক ও সামরিক সংগঠন, যার আনুষ্ঠানিক নাম 'আনসারুল্লাহ'। হুতি বিদ্রোহী গোষ্ঠী বর্তমানে দেশটির একটি বড় অংশ এবং কৌশলগতভাবে গুরুত্বপূর্ণ লোহিত সাগর উপকূল নিয়ন্ত্রণ করছে।<br>- ১৯৯০-এর দশকে ইয়েমেনের উত্তরাঞ্চলে যায়দি শিয়া সম্প্রদায়ের অধিকার আদায়ের লক্ষ্যে হোসেন বদরউদ্দিন আল-হুথির নেতৃত্বে এই আন্দোলনের সূত্রপাত ঘটে।<br>- ধর্মীয় বিশ্বাস: হুতিরা মূলত শিয়া ইসলামের একটি উপশাখা জায়দি সম্প্রদায়ের অনুসারী। ইয়েমেনের সুন্নি প্রধান জনসংখ্যার মধ্যে তারা উত্তর-পশ্চিমাঞ্চলের সংখ্যালঘু জনগোষ্ঠী।  <br>- প্রতিষ্ঠা ও নাম: ১৯৯০-এর দশকে তৎকালীন ইয়েমেনি সরকারের দুর্নীতি এবং ওয়াহাবি/সালাফি মতবাদের প্রসারের বিরুদ্ধে জায়দি সংস্কৃতির পুনর্জাগরণের লক্ষ্যে গোষ্ঠীটি গঠিত হয়। আন্দোলনের প্রতিষ্ঠাতা হুসেইন বদরেদ্দিন আল-হুতির নামানুসারে এই গোষ্ঠীকে 'হুতি' বলা হয়।</p>\r\n<p>উৎস: i) Britannica.<br>ii) BBC.</p>"}, {"id": "89", "question": "৮৯) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "90", "question": "৯০) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "91", "question": "৯১) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "92", "question": "৯২) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "93", "question": "৯৩) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "94", "question": "৯৪) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "95", "question": "৯৫) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "96", "question": "৯৬) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "97", "question": "৯৭) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "98", "question": "৯৮) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "99", "question": "৯৯) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0", "exp": ""}, {"id": "100", "question": "১০০) ", "option1": "", "option2": "", "option3": "", "option4": "", "answer": "0",