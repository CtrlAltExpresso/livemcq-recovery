p>2</sup> - ৪xy<br />= ২৯<sup>2</sup> - ৪.২০৪<br />= ৮৪১ - ৮১৬<br />= ২৫<br />&there4; x - y =&nbsp;&radic;২৫<br />= ৫<br />&there4; সংখ্যা দু'টির অন্তর = ১২x - ১২y<br />= ১২(x - y)<br />= ১২&nbsp;&times; ৫<br />= ৬০</p>"}]}, "exam_time": 1440000, "pk": 3024, "is_omr": false, "omr_time": 7200000, "is_mapping": false, "question_mapping": {}, "_source": "exam-view", "_exam_id": 3024}